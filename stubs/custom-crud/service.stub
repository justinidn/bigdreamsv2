<?php

declare(strict_types=1);

namespace App\Services;

use App\Models\{{modelName}};
use Exception;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Support\Facades\DB;

class {{modelName}}Service
{
    /**
     * Get paginated and filtered {{variableName}} list.
     *
     * @param array<string, mixed> $filters
     */
    public function getPaginatedList(array $filters): LengthAwarePaginator
    {
        $query = {{modelName}}::query();
        // Uncomment the line below if you want to eager load the 'department' relationship
        //$query = {{modelName}}::query()->with('relasi');

        if (! empty($filters['search'])) {
            $search = trim($filters['search']);

            $query->where(function ($q) use ($search): void {
                $q->where('name', 'like', "%{$search}%");
                // Tambahkan relasi/kolom pencarian lain jika diperlukan, contoh:
                // ->orWhere('description', 'like', "%{$search}%");
            });
        }

        if (isset($filters['status']) && $filters['status'] !== '') {
            $query->where('is_active', (bool) $filters['status']);
        }

        return $query->latest()->orderBy('id', 'desc')->paginate(10);
    }

    /**
     * Store a newly created {{singularVariable}} in storage.
     *
     * @param array<string, mixed> $data
     */
    public function store(array $data): {{modelName}}
    {
        return DB::transaction(function () use ($data): {{modelName}} {
            return {{modelName}}::create($data);
        });
    }

    /**
     * Update the specified {{singularVariable}} in storage.
     *
     * @param array<string, mixed> $data
     */
    public function update({{modelName}} ${{singularVariable}}, array $data): {{modelName}}
    {
        return DB::transaction(function () use (${{singularVariable}}, $data): {{modelName}} {
            ${{singularVariable}}->update($data);

            return ${{singularVariable}}->fresh();
        });
    }

    /**
     * Remove the specified {{singularVariable}} from storage.
     *
     * @throws Exception
     */
    public function delete({{modelName}} ${{singularVariable}}): bool
    {
        // Contoh validasi relasi sebelum dihapus (sesuaikan dengan relasi model Anda jika ada)
        // if (${{singularVariable}}->someRelation()->exists()) {
        //     throw new Exception('Data cannot be deleted because it is still related to other data.');
        // }

        return DB::transaction(function () use (${{singularVariable}}): bool {
            return (bool) ${{singularVariable}}->delete();
        });
    }

    /**
     * Get formatted paginated list for AJAX/Axios responses.
     *
     * @param array<string, mixed> $filters
     * @return array<string, mixed>
     */
    public function getFormattedPaginatedList(array $filters): array
    {
        ${{variableName}} = $this->getPaginatedList($filters);

        return [
            'status' => 'success',
            'data' => ${{variableName}}->items(),
            'pagination' => [
                'current_page' => ${{variableName}}->currentPage(),
                'last_page' => ${{variableName}}->lastPage(),
                'per_page' => ${{variableName}}->perPage(),
                'total' => ${{variableName}}->total(),
                'next_page_url' => ${{variableName}}->nextPageUrl(),
                'prev_page_url' => ${{variableName}}->previousPageUrl(),
            ],
        ];
    }
      /**
     * Get department options for dropdown.
     *
     * @return array<int, string>
     */
   // public function getDepartmentDropdown(): array
    //{
     //   return Department::getDropdownOptions();
    //}
}