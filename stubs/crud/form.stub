<dialog class="dialog" id="{{modelVariableSingular}}Modal" x-data="{{modelVariableSingular}}Modal()" @open-{{routePrefix}}-modal.window="openAdd()" @edit-{{routePrefix}}-modal.window="openEdit($event.detail)">
    <div class="dialog-header">
        <h1 class="dialog-title" x-text="isEdit ? 'Edit {{modelClass}}' : 'Tambah {{modelClass}} Baru'"></h1>
        <button type="button" class="btn-close" commandfor="{{modelVariableSingular}}Modal" command="close" aria-label="Close"></button>
    </div>
    <div class="dialog-body">
        <form id="{{modelVariableSingular}}Form" @submit.prevent="submitForm()">
            <div class="mb-3">
                <label for="{{modelVariableSingular}}_name" class="form-label">Nama {{modelClass}}</label>
                <input type="text" class="form-control form-control-sm" :class="{ 'is-invalid': errors.name }" id="{{modelVariableSingular}}_name" x-model="form.name" required>
                <template x-if="errors.name">
                    <div class="invalid-feedback" x-text="errors.name"></div>
                </template>
            </div>

            <div class="mb-3">
                <label for="{{modelVariableSingular}}_alias" class="form-label">Alias</label>
                <input type="text" class="form-control form-control-sm" :class="{ 'is-invalid': errors.alias }" id="{{modelVariableSingular}}_alias" x-model="form.alias" required>
                <template x-if="errors.alias">
                    <div class="invalid-feedback" x-text="errors.alias"></div>
                </template>
            </div>

            <div class="mb-3" x-show="isEdit">
                <label class="form-label">Status</label>
                <div class="form-field">
                    <div class="switch" style="--bs-switch-width: 2.75rem; --bs-switch-indicator-width: 1.5rem;">
                        <input type="checkbox" value="1" id="switchCustomWidth" role="switch" switch x-model="form.is_active">
                    </div>
                    <label for="switchCustomWidth">Active</label>
                </div>
            </div>
        </form>
    </div>

    <div class="dialog-footer">
        <x-button-close commandfor="{{modelVariableSingular}}Modal" command="close" />
        <x-button-save form="{{modelVariableSingular}}Form" />
    </div>
</dialog>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('{{modelVariableSingular}}Modal', () => ({
            isEdit: false,
            originalForm: {},
            form: {
                id: '',
                name: '',
                alias: '',
                is_active: true
            },
            errors: {},

            openAdd() {
                this.isEdit = false;
                this.form = {
                    id: '',
                    name: '',
                    alias: '',
                    is_active: true
                };
                this.originalForm = {};
                this.errors = {};
                document.getElementById('{{modelVariableSingular}}Modal').showModal();
            },

            openEdit(item) {
                this.isEdit = true;
                this.form = {
                    id: item.id,
                    name: item.name,
                    alias: item.alias,
                    is_active: Boolean(Number(item.is_active))
                };
                this.originalForm = {
                    ...this.form
                };
                this.errors = {};
                document.getElementById('{{modelVariableSingular}}Modal').showModal();
            },

            submitForm() {
                this.errors = {};

                const updateData = Object.fromEntries(
                    Object.entries(this.form)
                    .filter(([field, value]) => field !== 'id' && value !== this.originalForm[field])
                );

                if (this.isEdit && Object.keys(updateData).length === 0) {
                    window.dispatchEvent(new CustomEvent('show-toast', {
                        detail: {
                            title: 'Informasi',
                            message: 'Tidak ada perubahan data yang dilakukan.',
                            type: 'success'
                        }
                    }));
                    document.getElementById('{{modelVariableSingular}}Modal').close();
                    return;
                }

                const request = this.isEdit ?
                    axios.put(
                        "{{ route('{{routePrefix}}.update', ['{{modelVariableSingular}}' => '__ID__']) }}".replace('__ID__', this.form.id),
                        updateData
                    ) :
                    axios.post("{{ route('{{routePrefix}}.store') }}", this.form);

                request
                    .then(response => {
                        document.getElementById('{{modelVariableSingular}}Modal').close();
                        window.dispatchEvent(new CustomEvent('{{modelVariableSingular}}-saved'));

                        window.dispatchEvent(new CustomEvent('show-toast', {
                            detail: {
                                title: 'Berhasil',
                                message: response.data.message || 'Data berhasil disimpan.',
                                type: 'success'
                            }
                        }));
                    })
                    .catch(error => {
                        if (error.response) {
                            if (error.response.status === 422 && error.response.data.errors) {
                                const backendErrors = error.response.data.errors;
                                for (const field in backendErrors) {
                                    this.errors[field] = backendErrors[field][0];
                                }
                            } else if (error.response.status === 403) {
                                window.dispatchEvent(new CustomEvent('show-toast', {
                                    detail: {
                                        title: 'Akses Ditolak',
                                        message: 'Anda tidak memiliki permission untuk melakukan aksi ini.',
                                        type: 'error'
                                    }
                                }));
                            } else {
                                window.dispatchEvent(new CustomEvent('show-toast', {
                                    detail: {
                                        title: 'Kesalahan Server',
                                        message: error.response.data.message || 'Terjadi kesalahan pada server.',
                                        type: 'error'
                                    }
                                }));
                            }
                        } else {
                            window.dispatchEvent(new CustomEvent('show-toast', {
                                detail: {
                                    title: 'Koneksi Gagal',
                                    message: 'Tidak dapat terhubung ke server.',
                                    type: 'error'
                                }
                            }));
                        }
                    });
            }
        }));
    });
</script>