        @include('{{viewFolder}}.partials.{{formFileName}}-form')
    </div>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('{{modelVariableSingular}}Page', () => ({
                refresh{{modelClass}}() {
                    const table = this.$el.querySelector('.card');
                    if (table && Alpine.$data(table)) {
                        Alpine.$data(table).fetchData(1);
                    }
                },
                editItem(item) {
                    window.dispatchEvent(new CustomEvent('edit-{{routePrefix}}-modal', {
                        detail: item
                    }));
                },
                deleteItem(id) {
                    if (confirm('Yakin ingin menghapus data ini?')) {
                        axios.delete("{{ route('{{routePrefix}}.destroy', ['{{modelVariableSingular}}' => '__ID__']) }}".replace('__ID__', id))
                            .then(response => {
                                window.dispatchEvent(new CustomEvent('{{modelVariableSingular}}-saved'));

                                window.dispatchEvent(new CustomEvent('show-toast', {
                                    detail: {
                                        title: 'Berhasil',
                                        message: response.data.message || 'Data berhasil dihapus.',
                                        type: 'success'
                                    }
                                }));
                            })
                            .catch(error => {
                                if (error.response) {
                                    if (error.response.status === 422) {
                                        window.dispatchEvent(new CustomEvent('show-toast', {
                                            detail: {
                                                title: 'Peringatan',
                                                message: error.response.data.message || 'Data tidak dapat dihapus.',
                                                type: 'error'
                                            }
                                        }));
                                    } else if (error.response.status === 403) {
                                        window.dispatchEvent(new CustomEvent('show-toast', {
                                            detail: {
                                                title: 'Akses Ditolak',
                                                message: 'Anda tidak memiliki permission untuk melakukan aksi ini.',
                                                type: 'error'
                                            }
                                        }));
                                    } else {
                                        window.dispatchEvent(new CustomEvent('show-toast', {
                                            detail: {
                                                title: 'Kesalahan Server',
                                                message: error.response.data.message || 'Terjadi kesalahan pada server.',
                                                type: 'error'
                                            }
                                        }));
                                    }
                                } else {
                                    window.dispatchEvent(new CustomEvent('show-toast', {
                                        detail: {
                                            title: 'Koneksi Gagal',
                                            message: 'Tidak dapat terhubung ke server.',
                                            type: 'error'
                                        }
                                    }));
                                }
                            });
                    }
                }
            }));
        });
    </script>
</x-app-layout>